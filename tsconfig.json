{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "types": ["chrome"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sca/*": ["../sca/src/*"],
      "@shared/*": ["../sca/src/shared/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
