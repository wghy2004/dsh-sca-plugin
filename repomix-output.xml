  VerificationResult,
} from "../contract/types";

export interface SearchProvider {
  search(
    request: JobSearchRequest,
    signal?: AbortSignal,
  ): Promise<{
    jobs: Job[];
    evidence: Evidence[];
  }>;
}

export interface InspectionProvider {
  inspect(
    jobId: string,
